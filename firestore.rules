rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /accounts/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['serverId'])
        && request.resource.data.keys().hasAll(['serverId'])
        && request.resource.data.serverId is string
        && request.resource.data.serverId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
      allow update: if false;
      allow delete: if isOwner(uid);

      match /authorizedClients/{clientId} {
        allow get: if isOwner(uid);
        allow list: if isOwner(uid) && request.query.limit <= 100;
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['displayName', 'publicKey'])
          && request.resource.data.keys().hasAll(['displayName', 'publicKey'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 100
          && request.resource.data.publicKey is string
          && request.resource.data.publicKey.size() > 0
          && request.resource.data.publicKey.size() <= 512;
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
